# GeoMag Analyzer - Web-Service Mode environment configuration
# Copy to /etc/geomag-analyzer/geomag-analyzer.env (or local .env) and customize.
# NOTE: Always launch Uvicorn with `--workers 1`!

# Static read-only paths
GEOMAG_PROCESSED_DIR=/opt/geomag-analyzer/data/processed
GEOMAG_STATIC_CACHE_DIR=/opt/geomag-analyzer/data/cache
GEOMAG_FRONTEND_DIST_DIR=/opt/geomag-analyzer/frontend/dist

# Shared read-write runtime storage (runtime.sqlite + user_cache/)
GEOMAG_USER_DATA_DIR=/var/lib/geomag-analyzer/user_data

# Host / Origin allowlist for reverse-proxy CSRF protection (comma-separated)
GEOMAG_ALLOWED_HOSTS=geomag.example.edu,127.0.0.1,localhost
GEOMAG_ALLOWED_ORIGINS=https://geomag.example.edu

# Session auth & cookies
# Set GEOMAG_REQUIRE_AUTH=1 and supply a strong GEOMAG_BOOTSTRAP_TOKEN (or keep auto-generated)
# when protecting access via token, or GEOMAG_REQUIRE_AUTH=0 behind external SSO/Basic Auth.
GEOMAG_REQUIRE_AUTH=1
GEOMAG_COOKIE_SECURE=1
# GEOMAG_BOOTSTRAP_TOKEN=replace-with-strong-random-token

# Tier 3 compute quotas & single-threaded BLAS limits
GEOMAG_MAX_WORKERS=2
GEOMAG_MAX_MC_SURROGATES=1000
GEOMAG_MAX_ACTIVE_JOBS=4
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
