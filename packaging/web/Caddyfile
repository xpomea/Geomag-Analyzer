# GeoMag Analyzer - Caddy reverse proxy configuration (Web-Service Mode)
#
# IMPORTANT: Backend MUST run with `--workers 1`:
#   uvicorn geomag_api.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
#
# Replace `geomag.example.edu` with your public domain (automatic Let's Encrypt TLS).

geomag.example.edu {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Optional access gate example for department / campus deployments:
    # @allowed_ips remote_ip 192.168.0.0/16 10.0.0.0/8
    # basicauth {
    #     researcher $2a$14$REPLACE_WITH_CADDY_HASH_PASSWORD
    # }

    # Unbuffered SSE progress stream fallback
    @sse_events path /api/jobs/*/events
    reverse_proxy @sse_events 127.0.0.1:8000 {
        flush_interval -1
        header_up Host {http.request.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.scheme}
    }

    # REST API, WebSocket (/ws/jobs/*), and React SPA
    # Caddy automatically proxies HTTP/1.1 Upgrade headers for WebSockets.
    reverse_proxy 127.0.0.1:8000 {
        header_up Host {http.request.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.scheme}
    }
}
